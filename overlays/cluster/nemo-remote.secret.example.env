# Copy to nemo-remote.secret.env (gitignored) and set the real value.
# Token NeMo uses to call its REMOTE main + content_safety backends.
# Consumed by the overlay secretGenerator -> Secret "api-token-secret" (key: token),
# which the NemoGuardrails CR maps to env OPENAI_API_KEY.
token=REPLACE_ME_REMOTE_MODEL_TOKEN
