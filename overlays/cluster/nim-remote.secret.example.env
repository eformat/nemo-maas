# Copy to nim-remote.secret.env (gitignored) and set the real value.
# Token NeMo uses to call the remote content-safety NIM endpoint.
# Consumed by the overlay secretGenerator -> Secret "nim-token-secret" (key: token),
# which the NemoGuardrails CR maps to env NVIDIA_API_KEY.
token=REPLACE_ME_NIM_CONTENT_SAFETY_TOKEN
